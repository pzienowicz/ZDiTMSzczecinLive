<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="15dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:id="@+id/confirmDeleteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_delete_title"
        android:textColor="@color/app_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/confirmDeleteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/app_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/confirmDeleteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_delete_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="46dp"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp"
        android:text="@string/delete"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cancelDeleteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_outline_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/cancel"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold" />

</LinearLayout>
